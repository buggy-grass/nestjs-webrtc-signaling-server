model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String

  avatar    String?
  role      UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  peers           Peer[]
  sessions        Session[]
  devices         Device[]
  sentRoomInvites RoomInvite[]
  roomMembers     RoomMember[]
}